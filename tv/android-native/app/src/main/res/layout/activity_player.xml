<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- 电视上没有鼠标：不用 Media3 那套播放控制栏，自己做一条细进度条 -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="14dp"
        android:paddingEnd="40dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hud_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFEEEEEE"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/hud_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="#FFFFFFFF"
                android:secondaryProgressTint="#66FFFFFF" />

            <TextView
                android:id="@+id/hud_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFAAAAAA"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="◀▶ 快退快进（连按加速）   ↑↓ 音量   确定 暂停   菜单 选集   长按确定 清晰度   返回 退出"
            android:textColor="#FF999999"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:shadowColor="#FF000000"
        android:shadowRadius="8"
        android:textSize="18sp" />

    <!-- 静音是默认行为，提示条淡掉以后还得让用户知道「不是没声音，是被我静音了」 -->
    <TextView
        android:id="@+id/muted_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:background="#99000000"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:shadowColor="#FF000000"
        android:shadowRadius="6"
        android:text="🔇 已静音 · 按 ↑ 恢复声音"
        android:textColor="#FFDDDDDD"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="28dp"
        android:background="#E6181818"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- 播放中换集：以前必须退出播放器回详情页 -->
    <LinearLayout
        android:id="@+id/picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选集"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/picker_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="返回 关闭列表"
            android:textColor="#FF999999"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:padding="16dp"
        android:textSize="28sp"
        android:visibility="gone" />
</FrameLayout>
