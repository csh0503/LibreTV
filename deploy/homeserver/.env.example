# /opt/libretv/.env on homeserver (chmod 600). Names only - the real values live ONLY on the server.
# Never commit the real file. Change secrets with the scripts in scripts/ (hidden input), not by pasting into chat.

# Site access password (scripts/set-password.sh)
PASSWORD=
# Random signing key for sessions / proxy URLs (generated on the server: openssl rand -hex 32)
PROXY_SECRET=
# DuckDNS account token: DNS challenge for HTTPS certificates + IP updates (scripts/set-duckdns-token.sh)
# The same token is used by other services on this server (Vikunja, CUHK VPN page, OpenMausBot) - regenerating it breaks them all.
DUCKDNS_TOKEN=
# TMDB API key for posters / metadata (scripts/set-tmdb-key.sh)
TMDB_API_KEY=
# Preset sources: JSON array on ONE line, see default-sources.json (26 sources, adult ones removed 2026-11-09)
DEFAULT_SOURCES=
# Per-source search deadline in ms (slow / dead sources are skipped after this)
SEARCH_SOURCE_TIMEOUT_MS=5000
# bcrypt hash for the password page of the CUHK VPN panel served by the same Caddy (scripts/set-vpn-page-password.sh).
# Must be wrapped in single quotes in .env, otherwise Docker Compose expands the "$" in the hash.
VPN_PANEL_HASH=
